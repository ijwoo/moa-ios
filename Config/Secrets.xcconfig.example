// 이 파일을 Secrets.xcconfig 로 복사해 값을 채운다. Secrets.xcconfig 는 저장소에 올리지 않는다.
// xcconfig 에서 "//" 는 주석이라 URL 대신 호스트만 적는다.
PROXY_HOST = meeting-api.example.com
// 프록시 서버 .env 의 APP_TOKEN 과 같은 값 (Claude API 키가 아님)
PROXY_APP_TOKEN =
// 맥 에이전트(local-ai-agent)의 주소와 앱 토큰. 비워 두면 맥 기능 없이 회의 기록·요약만 쓴다
AGENT_HOST =
AGENT_APP_TOKEN =
