# 서버에만 두는 파일. 절대 커밋하지 않는다. (chmod 600)
ANTHROPIC_API_KEY=
# 앱이 보내는 토큰. 앱 빌드 설정(Secrets.xcconfig)과 같은 값. openssl rand -hex 32 로 만든다.
APP_TOKEN=
# 요약 모델: claude-opus-5-5(기본) | claude-sonnet-5-5 | claude-haiku-5-5
SUMMARY_MODEL=claude-opus-5-5
PORT=3100
HOST=127.0.0.1
# 하루 전체 요청 상한 (비용 보호)
DAILY_LIMIT=300
